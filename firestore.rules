rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo de servicios: lectura pública, escritura solo del dueño del negocio
    match /businesses/{businessId}/servicios/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == businessId;
    }

    // Turnos: cualquiera puede crear una solicitud, solo el dueño lee/gestiona
    match /businesses/{businessId}/turnos/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.uid == businessId;
    }

    // Clientes: privados, solo el dueño del negocio
    match /businesses/{businessId}/clientes/{id} {
      allow read, write: if request.auth != null && request.auth.uid == businessId;
    }

    // Caja: en plan gratis se puede ver y borrar, pero no crear ni modificar
    // movimientos (para generar el deseo de pasar a Pro sin dejarla inservible).
    match /businesses/{businessId}/caja/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == businessId;
      allow create, update: if request.auth != null && request.auth.uid == businessId &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.plan == "pro";
    }

    // Datos del negocio (nombre, tema, plan, vencimiento): lectura pública
    // (la necesita el catálogo para saber si el negocio está activo, y el panel
    // admin para listar vencimientos), escritura del dueño o del administrador
    // (Sebas, para bonificar plazos).
    match /businesses/{businessId} {
      allow read: if true;
      allow write: if request.auth != null &&
        (request.auth.uid == businessId || request.auth.uid == "eYcLh69WczLsEa0f612k5hbyULq2");
    }

    // Todo lo demás (consultorios, profesionales, etc.): solo el dueño
    match /businesses/{businessId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == businessId;
    }

    // Códigos de canje para pasar a la versión Pro.
    // Solo la cuenta de administrador (Sebas) puede crearlos y ver la lista completa,
    // desde el panel privado admin/index.html. Cualquier negocio autenticado puede
    // leer un código puntual para canjearlo (necesita saber el ID exacto), y solo
    // puede marcarlo como usado si todavía no fue canjeado — esto lo garantiza la
    // regla del lado del servidor, no se puede reusar aunque se manipule el cliente.
    match /codigosPro/{codigo} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.auth.uid == "eYcLh69WczLsEa0f612k5hbyULq2";
      allow create: if request.auth != null && request.auth.uid == "eYcLh69WczLsEa0f612k5hbyULq2";
      allow update: if (request.auth != null && resource.data.usado == false)
                     || (request.auth != null && request.auth.uid == "eYcLh69WczLsEa0f612k5hbyULq2");
      allow delete: if request.auth != null && request.auth.uid == "eYcLh69WczLsEa0f612k5hbyULq2";
    }
    // Configuración general de la plataforma (ej: días de aviso antes del
    // vencimiento). Solo la cuenta admin puede leerla y escribirla.
    match /configuracion/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == "eYcLh69WczLsEa0f612k5hbyULq2";
    }
  }
}
